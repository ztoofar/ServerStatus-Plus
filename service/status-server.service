[Unit]
Description=ServerStatus-Plus Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/usr/local/ServerStatus/server
ExecStart=/usr/local/ServerStatus/server/sergate -c /usr/local/ServerStatus/server/config.json
Restart=on-failure
RestartSec=3
LimitNOFILE=51200

[Install]
WantedBy=multi-user.target
